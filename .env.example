# Required. Free key from openalex.org/settings/api-key
OPENALEX_API_KEY=

# Optional. Materials Project reference data for the calculator comparison.
# Without it the calculator simply omits the reference column.
MP_API_KEY=

# Optional. The extractor and the answering engine are deterministic and need
# no model. Setting a provider adds an LLM pass that may only rephrase text
# already retrieved from the library; it cannot introduce a fact.
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Defaults shown.
DB_PATH=data/research_agent.db
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
