# Secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Generated by build_demo.py
demo/data.json
app/data.json
web/data.json

# SQLite write-ahead log. The database runs in WAL mode, so these two appear
# beside it whenever the service runs and vanish when it closes cleanly. They
# are runtime state, never content.
*.db-wal
*.db-shm
data/.collect-progress.json
data/fulltext.db

# The library ships packed: a git host refuses a file over 100 MB, and the
# database compresses about five times over. pack_db.py writes the archive,
# db.ensure_database unpacks it on first use. The archive is committed; this
# is not.
data/research_agent.db
data/research_agent.db-wal
data/research_agent.db-shm
!data/research_agent.db.zst
!data/research_agent.db.xz
